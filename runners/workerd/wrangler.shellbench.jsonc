// Copy into packages/computer/tests/. Same bindings as tests/wrangler.worker-backend.jsonc.
{
  "name": "computer-shellbench",
  "main": "./shellbench-worker.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "HOST", "class_name": "HostDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostDO"] }]
}
